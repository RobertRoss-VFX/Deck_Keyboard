[Desktop Entry]
Type=Application
Version=1.0
Name=Zainstaluj klawiaturę
GenericName=Instalator
Comment=Kliknij dwa razy. Jak system zapyta, wybierz Uruchom.
TryExec=/usr/bin/bash
Exec=/usr/bin/bash -c 'p="$0"; p="${p#file://}"; p="${p//%%20/ }"; d=$(dirname "$p"); cd "$d" && exec /usr/bin/bash ./install.sh || { echo "Nie znajduję instalatora w: $d"; read -r -p "Naciśnij Enter..."; exit 1; }' %k
Icon=system-software-install
Terminal=true
StartupNotify=false
Categories=Utility;
